{
  "name": "@flare/push",
  "private": true,
  "type": "module",
  "description": "Push notifications for apps on Flare: device tokens in the app's D1, sends through a Queue straight to APNs and FCM. Cloudflare only and no npm dependencies; Workers install it from GitHub (see PUSH.md).",
  "exports": {
    ".": "./src/index.ts",
    "./spaces": "./src/spaces.ts",
    "./schema.json": "./schema.json"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@sync/server": "link:../server",
    "@types/node": "^22",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@sync/server": "*"
  },
  "peerDependenciesMeta": {
    "@sync/server": {
      "optional": true
    }
  }
}
