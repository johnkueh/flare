{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // Better Auth needs node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/v1/*", "/dev/*", "/ofrep/*"] },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Development only: anonymous sign-in without App Attest (the iOS
    // simulator has none), development keys, and email codes kept in
    // /dev/outbox instead of sent. Turn all three off to deploy.
    "FLARE_AUTH_ALLOW_UNATTESTED": "true",
    "APP_ATTEST_ALLOW_DEVELOPMENT": "true",
    "DEV_OUTBOX": "true",
    "APP_ATTEST_APP_IDS": "",
    "ANDROID_APP_IDS": ""
  },
  // BETTER_AUTH_SECRET is a secret: .dev.vars locally, `wrangler secret put` deployed.
  "durable_objects": { "bindings": [{ "name": "SPACES", "class_name": "SpaceObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpaceObject"] }],
  "r2_buckets": [{ "binding": "SPACE_FILES", "bucket_name": "flare-example-files" }],
  // flags.json's flags, in a Flagship app. Locally (`pnpm dev`) they come from
  // wrangler's local store: `pnpm flags:local` creates them there.
  "flagship": [{ "binding": "FLAGS", "app_id": "flare-example" }],
  // Push notifications (@flare/push): notify() queues, the queue() handler sends.
  // APNS_KEY_P8, APNS_KEY_ID, APNS_TEAM_ID and FCM_SERVICE_ACCOUNT are secrets and
  // APNS_TOPICS a var (`flare-push setup` adds the var and lists the secrets); without them sends are
  // logged as failed and dropped.
  "queues": {
    "producers": [{ "binding": "PUSH_QUEUE", "queue": "flare-example-push" }],
    "consumers": [{ "queue": "flare-example-push", "max_batch_size": 100, "max_retries": 5 }]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "flare-example", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
