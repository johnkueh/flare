{
  // `pnpm build`: plain JS and .d.ts in dist/, checked in, so a Worker, a
  // bundler or the CLI can use the package straight from GitHub.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  },
  "exclude": ["src/*.test.ts"]
}
