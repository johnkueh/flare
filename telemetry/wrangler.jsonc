// The standalone ingest Worker shared by every app. Each app gets a public
// key in APP_KEYS (not a secret: it ships in the app, like a GA4 id).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flare-telemetry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "pipelines": [{ "binding": "EVENTS", "stream": "YOUR_STREAM_ID" }],
  "vars": {
    "APP_KEYS": "{\"k_example_000000000000000000000001\":\"glp3\"}"
  },
  "observability": { "enabled": true }
}
