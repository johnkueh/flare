// The standalone ingest Worker shared by every app. Each app gets a public
// key in APP_KEYS (not a secret: it ships in the app, like a GA4 id).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flare-telemetry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "pipelines": [{ "binding": "EVENTS", "stream": "071be0d41f5844c2808bb5bc488cf506" }],
  "vars": {
    "APP_KEYS": "{\"k_glp3_2eb353f7b6f2cb58f9a23e7f\":\"glp3\",\"k_snuglog_77fbbfe9dca913fdbc5d4da3\":\"snuglog\"}"
  },
  "observability": { "enabled": true }
}
